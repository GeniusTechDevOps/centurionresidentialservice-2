---
import FormatText from "../../hooks/FormatText";
import type { RootObject } from "../../interfaces/dbData";

export interface Props {
  data: RootObject;
}

const { data } = Astro.props;
const isEnabled = data?.widgets?.areasWeServe ?? data?.widgets?.areasweserve;
const services = (data?.services ?? []).slice(0, 8); // Limitamos para mantener la estética
const locations = (data?.dataGeneral?.location ?? []).slice(0, 7);

interface BentoService {
  name: string;
  href: string;
}

interface BentoItem {
  city: string;
  slug: string;
  services: BentoService[];
}

const bentoData: BentoItem[] = locations.map((loc: any) => ({
  city: loc.city,
  slug: FormatText(loc.city),
  services: services.map((s: any) => ({
    name: s.title,
    href: `/services/${FormatText(s.title)}-in-${FormatText(loc.city)}`,
  })),
}));
---

{
  isEnabled && (
    <section class="py-24 overflow-hidden">
      <div class="container mx-auto px-6 max-w-7xl">
        {/* Header Estilo Editorial */}
        <div class="flex flex-col md:flex-row items-start md:items-end gap-6 mb-16">
          <div class="flex-1">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary text-white text-xs font-bold mb-4 border border-indigo-100">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75" />
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary" />
              </span>
              LIVE COVERAGE
            </div>
            <h2 class="text-4xl md:text-6xl font-extrabold text-secondary tracking-tight leading-none">
              Local expertise, <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary">
                nationwide reach.
              </span>
            </h2>
          </div>
          <p class="max-w-xs text-slate-100 text-sm md:text-base border-l-2 border-slate-200 pl-6 py-2">
            Select your city to discover specialized solutions tailored to your
            neighborhood’s needs.
          </p>
        </div>

        {/* Bento Grid Layout */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bentoData.map((item: BentoItem) => (
            <div class="group relative bg-white border border-slate-200/60 rounded-[2.5rem] p-8 hover:bg-secondary transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] hover:-translate-y-2 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-indigo-500/20">
              {/* Decoración Background */}
              <div class="absolute -top-12 -right-12 w-32 h-32 bg-secondary rounded-full group-hover:bg-indigo-500/10 transition-colors" />

              <div class="relative z-10">
                <div class="flex justify-between items-start mb-10">
                  <h3 class="text-2xl font-bold text-slate-800 group-hover:text-white transition-colors duration-300">
                    {item.city}
                  </h3>
                  <div class="w-10 h-10 rounded-full bg-slate-50 group-hover:bg-white/50 flex items-center justify-center text-slate-600 group-hover:text-secondary transition-all duration-300">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </div>
                </div>

                {/* Tags/Chips Estilo Moderno */}
                <div class="flex flex-wrap gap-2">
                  {item.services.map((service) => (
                    <a
                      href={service.href}
                      class="px-4 py-2 rounded-xl bg-slate-50 group-hover:bg-white/5 border border-slate-100 group-hover:border-white/10 text-slate-600 group-hover:text-white text-[13px] font-medium transition-all duration-300 hover:!bg-primary hover:!text-white hover:scale-105"
                    >
                      {service.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

        {/* CTA de contacto rápido */}
        <div class="mt-16 text-center">
          <p class="text-slate-400 text-sm">
            Don't see your area?
            <a
              href="/contact"
              class="text-primary font-bold ml-1 hover:underline underline-offset-4 cursor-pointer"
            >
              Check our extended map →
            </a>
          </p>
        </div>
      </div>
    </section>
  )
}
